  <script>
    // Set year for footer
    document.addEventListener('DOMContentLoaded', function(){
      const el = document.querySelector('footer div');
      if(el){ el.innerHTML = '© ' + new Date().getFullYear() + ' Your Name — Built with Flask + Tailwind'; }
    });
  </script>
